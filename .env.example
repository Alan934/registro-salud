# ---- Base de datos (Neon) ----
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# ---- Credenciales de acceso (cambialas si querés) ----
AUTH_USER=silvia
AUTH_PASSWORD=tu-password

# ---- Secreto para firmar la cookie de sesion (no compartir) ----
AUTH_SECRET=generar-con-openssl-rand-base64-32
